# =============================================================================
# Microservices Deployment Environment Variables Configuration
# =============================================================================

# --- Service Port Allocations (Configurable for VM Deployment) ---
# Default Ports: Change if occupied (e.g., GATEWAY_PORT=8090, AUTH_SERVICE_PORT=8091)
GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
FORMS_SERVICE_PORT=8082
SUBMISSION_SERVICE_PORT=8083
STORAGE_SERVICE_PORT=8084
ADMIN_SERVICE_PORT=8085

# --- Database Configuration ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me

# --- JWT Security ---
JWT_SECRET=SecretKeyForJWTAppraisalMustBeAtLeast256BitsLongForHMACSHA256
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- Storage & Backup Directories ---
UPLOAD_DIR=/app/uploads
BACKUP_DIR=/app/backups

# --- Mail Configuration ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=appraisal@dypiu.ac.in
SMTP_PASSWORD=your_app_password
MAIL_FROM=noreply@dypiu.edu.in
